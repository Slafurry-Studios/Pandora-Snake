  m_Script: {fileID: 11500000, guid: 733d0064b3af99f9e8e90499c246c2fa, type: 3}
  m_Name: BorderExit
  m_EditorClassIdentifier: 
  id: border_exit
  dialogs:
  - faceShotSprite: {fileID: -210164756, guid: 434cdf58bef4cd049ba5587c26722b19, type: 3}
    name: Pandora
    dialog: Sniki? ... Where are you going?
  - faceShotSprite: {fileID: -483550040, guid: 322ac543267fb4206b8a94fd03d7deda, type: 3}
    name: Jormugandr
    dialog: Away.
  - faceShotSprite: {fileID: -210164756, guid: 434cdf58bef4cd049ba5587c26722b19, type: 3}
    name: Pandora
    dialog: But... the city is over there.
  - faceShotSprite: {fileID: -483550040, guid: 322ac543267fb4206b8a94fd03d7deda, type: 3}
    name: Jormugandr
    dialog: Exactly.
  - faceShotSprite: {fileID: -210164756, guid: 434cdf58bef4cd049ba5587c26722b19, type: 3}
    name: Pandora
    dialog: You don't want to destroy the city anymore?
  - faceShotSprite: {fileID: -483550040, guid: 322ac543267fb4206b8a94fd03d7deda, type: 3}
    name: Jormugandr
    dialog: No.
  - faceShotSprite: {fileID: -210164756, guid: 434cdf58bef4cd049ba5587c26722b19, type: 3}
    name: Pandora
    dialog: You don't want more subscribers?
  - faceShotSprite: {fileID: -483550040, guid: 322ac543267fb4206b8a94fd03d7deda, type: 3}
    name: Jormugandr
    dialog: No.
  - faceShotSprite: {fileID: -210164756, guid: 434cdf58bef4cd049ba5587c26722b19, type: 3}
    name: Pandora
    dialog: ...You don't event want to stream with me again?
  - faceShotSprite: {fileID: -483550040, guid: 322ac543267fb4206b8a94fd03d7deda, type: 3}
    name: Jormugandr
    dialog: I want peace
  - faceShotSprite: {fileID: -210164756, guid: 434cdf58bef4cd049ba5587c26722b19, type: 3}
    name: Pandora
    dialog: ...
  - faceShotSprite: {fileID: -483550040, guid: 322ac543267fb4206b8a94fd03d7deda, type: 3}
    name: Jormugandr
    dialog: ...
  - faceShotSprite: {fileID: -210164756, guid: 434cdf58bef4cd049ba5587c26722b19, type: 3}
    name: Pandora
    dialog: I know i killed your loved ones, but it should not end here
  - faceShotSprite: {fileID: -210164756, guid: 434cdf58bef4cd049ba5587c26722b19, type: 3}
    name: Pandora
    dialog: Do you want me to revive them again?
  - faceShotSprite: {fileID: -1191487637, guid: 6ec316fbdc3f040b1aa7b6ec2cb6de29, type: 3}
    name: Jormugandr
    dialog: For god sake! Just end my suffering right here!
  - faceShotSprite: {fileID: -418998742, guid: 41f917c7f178cd12a839643bfac74857, type: 3}
    name: Pandora
    dialog: That's the most disappointing you've ever said.
  - faceShotSprite: {fileID: -418998742, guid: 41f917c7f178cd12a839643bfac74857, type: 3}
    name: Pandora
    dialog: Useless, You are dissapointment!
